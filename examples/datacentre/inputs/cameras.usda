#usda 1.0
(
    upAxis = "Z"
    metersPerUnit = 1
)
def Scope "Renders" {
    def Camera "overview" {
        float focalLength = 32
        float horizontalAperture = 36
        float verticalAperture = 22.5
        double3 xformOp:translate = (35, 24, 140)
        uniform token[] xformOpOrder = ["xformOp:translate"]
        float2 clippingRange = (0.1, 1000)
    }
    def Camera "lookthrough" {
        float focalLength = 3
        float horizontalAperture = 8
        float verticalAperture = 5
        float2 clippingRange = (0.1, 1000)
    }
}
